META_START
    name: alice1
    parameters: bob_id
    csockets: 0 -> bob
    epr_sockets: 0 -> bob
META_END

^b1 {type = QC}:
    run_request() : req

^b2 {type = QL}:
    tuple<m0; m1> = run_subroutine() : post_epr

^b3 {type = CL}:
    return_result(m0)
    return_result(m1)

// Hopefully does not reach the post epr
SUBROUTINE post_epr
    params: 
    returns: m0, m1
    uses: 0, 1
    keeps:
    request:
  NETQASM_START
    set Q0 0
    set Q1 1

    init Q1
    h Q1
    cnot Q1 Q0

    cphase Q0 Q1

    cnot Q1 Q0

    meas Q0 M0
    meas Q0 M1
    store M0 @output[0]
    store M1 @output[1]
  NETQASM_END

REQUEST req
  callback_type:
  callback: 
  return_vars:
  remote_id: {bob_id}
  epr_socket_id: 0
  num_pairs: 1
  virt_ids: all 0
  timeout: 1000
  fidelity: 1.0
  typ: create_keep
  role: create
